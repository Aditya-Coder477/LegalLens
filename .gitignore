# ──────────────────────────────────────────────
# LegalLens — .gitignore
# ──────────────────────────────────────────────

# SECURITY: Never commit credentials
.env
*.env
!.env.example

# Collected legal data (can be very large)
legal-data/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.coveragerc

# IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs (keep structure, not content in repo)
*.log
!legal-data/logs/.gitkeep

# Temporary files
*.tmp
*.part
*.bak

# Jupyter (if used for exploration)
.ipynb_checkpoints/
*.ipynb

# Ruff cache
.ruff_cache/

# Frontend (Node / Next.js)
node_modules/
frontend/node_modules/
.next/
frontend/.next/
frontend/out/
.env*.local
frontend/.env*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Databases & local state
*.sqlite3
*.db-journal
*.sqlite3-journal

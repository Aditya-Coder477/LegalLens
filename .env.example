# ══════════════════════════════════════════════════════════════════
# LegalLens — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────
# data.gov.in Open Government Data API
# Register at: https://data.gov.in/user/register
# Go to: My Account → API Access → Generate Key
# Free tier: 1,000 calls/day
# ──────────────────────────────────────────────
DATA_GOV_API_KEY=your_data_gov_api_key_here

# ──────────────────────────────────────────────
# LLM Domain Classifier (optional)
# Only used when running with --enable-llm flag.
# Supported providers: google, openai, anthropic, azure
# Leave blank to use keyword-only classification.
# ──────────────────────────────────────────────
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# ──────────────────────────────────────────────
# Source Base URLs (override for testing only)
# Do NOT change these in production.
# ──────────────────────────────────────────────
INDIA_CODE_BASE_URL=https://www.indiacode.nic.in
INDIA_CODE_API_BASE=https://indiacode.ecourtsindia.com/api
DATA_GOV_API_BASE=https://api.data.gov.in
NALSA_BASE_URL=https://nalsa.gov.in
LEGISLATIVE_DEPT_BASE_URL=https://legislative.gov.in
MEITY_BASE_URL=https://www.meity.gov.in
SCI_BASE_URL=https://www.sci.gov.in

# ──────────────────────────────────────────────
# Pipeline Behaviour (optional overrides)
# ──────────────────────────────────────────────
# Override config.yaml request_delay_seconds
# PIPELINE_REQUEST_DELAY=2.5

# Override config.yaml max_retries
# PIPELINE_MAX_RETRIES=3

# Tesseract binary path (if not on PATH)
# TESSERACT_CMD=/usr/bin/tesseract
